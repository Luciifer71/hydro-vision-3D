# ============================================================
# HYDRO-VISION-3D — Git Ignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.log

# Virtual environments
.venv/
venv/
env/

# OS / IDE
.DS_Store
.vscode/
.idea/
Thumbs.db

# Node / frontend
node_modules/
frontend/dist/

# Datasets and generated data
data/

# Training outputs
runs/
*.cache

# Model weights / exported models
*.pt
*.engine
*.onnx

# Backups / archives
*.zip

# Generated frontend / runtime artifacts
static/snapshots/

# Allow intentionally committed model weights under models/
!models/
!models/*.pt