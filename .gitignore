# Byte-compiled / Python internal files
__pycache__/
*.py[cod]
*$py.class
*.log

# Virtual Environments
.venv/
venv/
env/

# Operating System & IDE Artifacts
.DS_Store
.vscode/
.idea/
Thumbs.db

# Dependencies & Build Output
node_modules/
frontend/dist/

# Ignored Datasets & Raw Downloads (Keep repo lightweight)
data/multiclass_dataset/raw_downloads/*
data/multiclass_dataset/images/*
data/multiclass_dataset/labels/*
data/raw_videos/*
data/external_datasets/

# Allow essential sample data & configs for judges
!data/raw_videos/master_video.mp4
!data/multiclass_dataset/road_hazards.yaml
!data/multiclass_dataset/raw_downloads/.gitkeep
!data/multiclass_dataset/images/train/.gitkeep
!data/multiclass_dataset/images/val/.gitkeep
!data/multiclass_dataset/images/test/.gitkeep
!data/multiclass_dataset/labels/train/.gitkeep
!data/multiclass_dataset/labels/val/.gitkeep
!data/multiclass_dataset/labels/test/.gitkeep

# Ignore training outputs & extra cache
runs/*
*.cache
static/snapshots/

# Allow judges to download your trained weights in models/ or runs/
*.pt
!models/*.pt
!models/best.pt
!runs/hydro_vision_m4pro/weights/best.pt